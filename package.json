{
  "name": "sonicwaretool",
  "productName": "SonicwareTool",
  "version": "2.0.0",
  "description": "Batch audio converter for hardware samplers like the Sonicware Lofi-12 XT and Elektron Digitakt, powered by SoX.",
  "main": "src/main/main.js",
  "author": "tristan202",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristan202/sonicwaretool.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:all": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tristan202.sonicwaretool",
    "productName": "SonicwareTool",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "en-US",
      "da",
      "de",
      "es",
      "fr",
      "it",
      "sv"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Sonicware Lofi-12 XT Tool",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
